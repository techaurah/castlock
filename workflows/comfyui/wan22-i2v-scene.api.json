{
  "1": {
    "_meta": {
      "title": "Load Image: scene still (from zimage-stills.api.json or any non-character still)"
    },
    "class_type": "LoadImage",
    "inputs": {
      "image": "castlock-scene-still.png"
    }
  },
  "10": {
    "_meta": {
      "title": "ModelSamplingSD3 (high-noise chain, shift 5)"
    },
    "class_type": "ModelSamplingSD3",
    "inputs": {
      "model": [
        "8",
        0
      ],
      "shift": 5
    }
  },
  "11": {
    "_meta": {
      "title": "ModelSamplingSD3 (low-noise chain, shift 5)"
    },
    "class_type": "ModelSamplingSD3",
    "inputs": {
      "model": [
        "9",
        0
      ],
      "shift": 5
    }
  },
  "12": {
    "_meta": {
      "title": "WanImageToVideo (720x1280, 81 frames = about 5s at 16fps)"
    },
    "class_type": "WanImageToVideo",
    "inputs": {
      "batch_size": 1,
      "height": 1280,
      "length": 81,
      "negative": [
        "7",
        0
      ],
      "positive": [
        "6",
        0
      ],
      "start_image": [
        "1",
        0
      ],
      "vae": [
        "3",
        0
      ],
      "width": 720
    }
  },
  "13": {
    "_meta": {
      "title": "KSamplerAdvanced high-noise (steps 0-2 of 4, adds noise)"
    },
    "class_type": "KSamplerAdvanced",
    "inputs": {
      "add_noise": "enable",
      "cfg": 1,
      "end_at_step": 2,
      "latent_image": [
        "12",
        2
      ],
      "model": [
        "10",
        0
      ],
      "negative": [
        "12",
        1
      ],
      "noise_seed": 54321,
      "positive": [
        "12",
        0
      ],
      "return_with_leftover_noise": "enable",
      "sampler_name": "euler",
      "scheduler": "simple",
      "start_at_step": 0,
      "steps": 4
    }
  },
  "14": {
    "_meta": {
      "title": "KSamplerAdvanced low-noise (steps 2-4 of 4, no new noise)"
    },
    "class_type": "KSamplerAdvanced",
    "inputs": {
      "add_noise": "disable",
      "cfg": 1,
      "end_at_step": 4,
      "latent_image": [
        "13",
        0
      ],
      "model": [
        "11",
        0
      ],
      "negative": [
        "12",
        1
      ],
      "noise_seed": 54321,
      "positive": [
        "12",
        0
      ],
      "return_with_leftover_noise": "disable",
      "sampler_name": "euler",
      "scheduler": "simple",
      "start_at_step": 2,
      "steps": 4
    }
  },
  "15": {
    "_meta": {
      "title": "VAE Decode"
    },
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "14",
        0
      ],
      "vae": [
        "3",
        0
      ]
    }
  },
  "16": {
    "_meta": {
      "title": "CreateVideo (16 fps)"
    },
    "class_type": "CreateVideo",
    "inputs": {
      "fps": 16,
      "images": [
        "15",
        0
      ]
    }
  },
  "17": {
    "_meta": {
      "title": "Save Video"
    },
    "class_type": "SaveVideo",
    "inputs": {
      "codec": "auto",
      "filename_prefix": "castlock/scene",
      "format": "auto",
      "video": [
        "16",
        0
      ]
    }
  },
  "2": {
    "_meta": {
      "title": "Load CLIP (UMT5 XXL fp8)"
    },
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "device": "default",
      "type": "wan"
    }
  },
  "3": {
    "_meta": {
      "title": "Load VAE (wan 2.1)"
    },
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "wan_2.1_vae.safetensors"
    }
  },
  "4": {
    "_meta": {
      "title": "Load Diffusion Model (Wan 2.2 I2V high noise 14B fp8)"
    },
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "wan2.2_i2v_high_noise_14B_fp8_scaled.safetensors",
      "weight_dtype": "default"
    }
  },
  "5": {
    "_meta": {
      "title": "Load Diffusion Model (Wan 2.2 I2V low noise 14B fp8)"
    },
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "wan2.2_i2v_low_noise_14B_fp8_scaled.safetensors",
      "weight_dtype": "default"
    }
  },
  "6": {
    "_meta": {
      "title": "Positive prompt: scene motion"
    },
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "2",
        0
      ],
      "text": "CASTLOCK: describe the scene motion here. Example: slow gentle camera drift forward, clouds moving, light shimmering on water."
    }
  },
  "7": {
    "_meta": {
      "title": "Negative prompt"
    },
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "2",
        0
      ],
      "text": "face changing, different person, morphing features, extra fingers, deformed hands, distorted face, camera movement, camera orbit, zoom, scene change, relighting, subtitles, watermark, low quality, blurry, static distortion"
    }
  },
  "8": {
    "_meta": {
      "title": "LoRA high noise (lightx2v 4-step, official template path)"
    },
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "lora_name": "wan2.2_i2v_lightx2v_4steps_lora_v1_high_noise.safetensors",
      "model": [
        "4",
        0
      ],
      "strength_model": 1
    }
  },
  "9": {
    "_meta": {
      "title": "LoRA low noise (lightx2v 4-step, official template path)"
    },
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "lora_name": "wan2.2_i2v_lightx2v_4steps_lora_v1_low_noise.safetensors",
      "model": [
        "5",
        0
      ],
      "strength_model": 1
    }
  }
}